            userAnswers[currentQuestionIndex] = optIdx;
            let q = activeQuestions[currentQuestionIndex];
            
            if (optIdx !== q.correctAnswer) {
                if (!userPersonalData.mistakes.some(m => m.questionText === q.questionText)) {
