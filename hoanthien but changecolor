        function renderHabitTracker() {
            const grid = document.getElementById('habit-grid');
            if (!grid) return;
            let html = '', streak = 0, today = new Date();
            let dates = [];
            for (let i = 6; i >= 0; i--) {
                let d = new Date(); d.setDate(today.getDate() - i); dates.push(d);
            }
            dates.forEach(d => {
                let dateStr = d.toISOString().split('T')[0];
                let isChecked = userPersonalData.habits && userPersonalData.habits[dateStr];
                let dayName = d.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit' });
                if (isChecked) streak++;
                html += `<div class="bg-slate-50 p-4 rounded-2xl border ${isChecked ? 'border-[#D6336C] bg-[#FFF5F8]' : 'border-slate-200'} text-center space-y-2"><div class="text-xs font-semibold text-slate-500">${dayName}</div><div class="text-xl ${isChecked ? 'text-[#D6336C]' : 'text-slate-300'}"><i class="fa-solid ${isChecked ? 'fa-circle-check' : 'fa-circle'}"></i></div><div class="text-[10px] ${isChecked ? 'text-[#D6336C] font-bold' : 'text-slate-400'}">${isChecked ? 'Đã học' : 'Chưa học'}</div></div>`;
            });
            grid.innerHTML = html;
            document.getElementById('streak-count').innerText = streak;
        }

        function exportBackup() {
            if (!currentUser || currentUser.role !== 'admin') return alert('Bạn không có quyền thực hiện thao tác này!');
            let dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));
            let dlAnchor = document.createElement('a');
            dlAnchor.setAttribute("href", dataStr);
            dlAnchor.setAttribute("download", "vmu_exam_backup.json");
            document.body.appendChild(dlAnchor);
            dlAnchor.click();
            dlAnchor.remove();
        }

        function importBackup(event) {
            if (!currentUser || currentUser.role !== 'admin') return alert('Bạn không có quyền thực hiện thao tác này!');
            let file = event.target.files[0];
            if (!file) return;
            let reader = new FileReader();
            reader.onload = function(e) {
                try {
                    let imported = JSON.parse(e.target.result);
                    if (imported && imported.subjects) {
                        appData = imported;
                        saveAppDataToCloud();
                        renderHome();
                        alert('Nhập dữ liệu thành công!');
                    } else { alert('File JSON không hợp lệ!'); }
                } catch (err) { alert('Lỗi đọc file!'); }
            };
            reader.readAsText(file);
        }
    </script>
</body>
</html>
