<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VMU TestExam Pro - Hệ thống tryhard giật HỌC BỔNG của npct</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Mammoth.js để đọc file Word (.docx) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <!-- Firebase SDKs -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { 
            getFirestore, doc, setDoc, getDoc, collection, getDocs, deleteDoc, updateDoc, onSnapshot 
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCpbC9aaVJdLiscTP4D8dCqqvRn1tAalxg",
            authDomain: "med-exam-app-bbbce.firebaseapp.com",
            projectId: "med-exam-app-bbbce",
            storageBucket: "med-exam-app-bbbce.firebasestorage.app",
            messagingSenderId: "879842215036",
            appId: "1:879842215036:web:bc8f61c1bc37ce184ef5f9",
            measurementId: "G-36K7452DP4"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        window.firebaseDB = db;
        window.firebaseDoc = doc;
        window.firebaseSetDoc = setDoc;
        window.firebaseGetDoc = getDoc;
        window.firebaseCollection = collection;
        window.firebaseGetDocs = getDocs;
        window.firebaseDeleteDoc = deleteDoc;
        window.firebaseUpdateDoc = updateDoc;
        window.firebaseOnSnapshot = onSnapshot;

        // Khởi chạy ứng dụng khi Firebase đã sẵn sàng
        window.addEventListener('DOMContentLoaded', () => {
            if (typeof window.initAppSession === 'function') {
                window.initAppSession();
            }
        });
    </script>
</head>
<body class="bg-[#FFF5F8] text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-[#D6336C] text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                <div class="bg-white text-[#D6336C] p-2 rounded-xl font-bold text-xl shadow">
                    <i class="fa-solid fa-stethoscope"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">VMU TestExam Pro</h1>
                    <p class="text-xs text-[#FFB6C1]">Hệ thống tryhard giật HỌC BỔNG của npct</p>
                </div>
            </div>
            <nav class="flex items-center space-x-2 md:space-x-4">
                <button onclick="switchTab('home')" id="nav-home" class="px-3 py-1.5 rounded-lg text-sm font-medium bg-[#FF4081] transition"><i class="fa-solid fa-house mr-1"></i> Trang chủ</button>
                <button onclick="switchTab('mistakes')" id="nav-mistakes" class="px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-[#FF4081] transition relative"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Ôn câu sai <span id="badge-mistakes" class="absolute -top-1 -right-1 bg-[#FF4081] text-white text-[10px] px-1.5 py-0.2 rounded-full font-bold hidden">0</span></button>
                <button onclick="switchTab('habit')" id="nav-habit" class="px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-[#FF4081] transition"><i class="fa-solid fa-calendar-check mr-1"></i> Habit Tracker</button>
                
                <button onclick="openUsersModal()" id="nav-users-btn" class="px-3 py-1.5 rounded-lg text-sm font-medium bg-[#FF4081] hover:bg-[#D6336C] transition hidden flex items-center">
                    <i class="fa-solid fa-users-gear mr-1"></i> Duyệt Users
                </button>

                <div class="flex items-center space-x-2 bg-[#b52658]/50 px-3 py-1.5 rounded-xl border border-[#FFB6C1]/40 text-sm">
                    <i class="fa-solid fa-user-shield text-[#FFB6C1]" id="user-role-icon"></i>
                    <span id="nav-username" class="font-medium">Khách</span>
                    <button onclick="logoutAccount()" class="text-[#FFB6C1] hover:text-white ml-2 text-xs underline">Đăng xuất</button>
                </div>

                <div class="relative group" id="admin-data-menu">
                    <button class="px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-[#FF4081] transition"><i class="fa-solid fa-database mr-1"></i> Dữ liệu</button>
                    <div class="absolute right-0 mt-1 w-48 bg-white text-slate-700 rounded-lg shadow-xl py-2 hidden group-hover:block border border-slate-100 z-50">
                        <button onclick="exportBackup()" class="w-full text-left px-4 py-2 text-sm hover:bg-[#FFF5F8] hover:text-[#D6336C] flex items-center"><i class="fa-solid fa-download mr-2 text-[#D6336C]"></i> Xuất dữ liệu (JSON)</button>
                        <label class="w-full text-left px-4 py-2 text-sm hover:bg-[#FFF5F8] hover:text-[#D6336C] flex items-center cursor-pointer">
                            <i class="fa-solid fa-upload mr-2 text-blue-600"></i> Nhập dữ liệu (JSON)
                            <input type="file" accept=".json" class="hidden" onchange="importBackup(event)">
                        </label>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">
        
        <!-- TAB 1: TRANG CHỦ -->
        <div id="tab-home" class="space-y-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">Danh Sách Môn Học & Đề Thi</h2>
                    <p class="text-sm text-slate-500">Lựa chọn bài học để bắt đầu luyện đề y khoa.</p>
                </div>
                <div id="admin-action-buttons" class="flex flex-wrap gap-2 hidden">
                    <button onclick="openSubjectModal()" class="bg-[#D6336C] hover:bg-[#FF4081] text-white px-4 py-2 rounded-xl text-sm font-medium transition shadow-sm flex items-center">
                        <i class="fa-solid fa-plus mr-2"></i> Thêm Môn Học
                    </button>
                    <button onclick="openCreateExamModal()" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-xl text-sm font-medium transition shadow-sm flex items-center">
                        <i class="fa-solid fa-file-circle-plus mr-2"></i> Tạo Đề / Tải Folder Word
                    </button>
                </div>
            </div>

            <div id="subjects-container" class="space-y-4"></div>
        </div>

        <!-- TAB 2: LÀM BÀI THI -->
        <div id="tab-exam" class="hidden space-y-6">
            <div class="flex items-center justify-between bg-white px-6 py-4 rounded-2xl shadow-sm border border-slate-100">
                <button onclick="switchTab('home')" class="text-slate-600 hover:text-[#D6336C] font-medium text-sm flex items-center transition">
                    <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại trang chủ
                </button>
                <h3 id="exam-title-header" class="font-bold text-lg text-slate-900 truncate max-w-xl">Tên bài học</h3>
                <span id="exam-badge-subject" class="bg-[#FFF5F8] text-[#D6336C] text-xs font-semibold px-3 py-1 rounded-full border border-[#FFB6C1]">Môn học</span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <div class="space-y-6 lg:col-span-1">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 space-y-4">
                        <h4 class="font-bold text-slate-800 text-sm uppercase tracking-wider border-b pb-2"><i class="fa-solid fa-chart-pie mr-2 text-[#D6336C]"></i> Kết quả</h4>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between"><span class="text-slate-500">Đã hoàn thành:</span><span id="stat-completed" class="font-bold text-slate-800">0/0</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Đúng:</span><span id="stat-correct" class="font-bold text-emerald-600">0</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Điểm:</span><span id="stat-score" class="font-bold text-[#D6336C] text-base">0.00</span></div>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 space-y-4">
                        <h4 class="font-bold text-slate-800 text-sm uppercase tracking-wider border-b pb-2"><i class="fa-solid fa-gear mr-2 text-slate-600"></i> Tùy chỉnh</h4>
                        <div class="space-y-4 text-sm">
                            <div class="flex items-center justify-between"><span class="text-slate-600">Hiện đáp án ngay:</span><label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" id="setting-show-answer" class="sr-only peer" checked onchange="toggleSettingShowAnswer(this)"><div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#D6336C]"></div></label></div>
                            <div class="flex items-center justify-between"><span class="text-slate-600">Tự động chuyển câu:</span><label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" id="setting-auto-next" class="sr-only peer" onchange="toggleSettingAutoNext(this)"><div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#D6336C]"></div></label></div>
                            <div class="flex items-center justify-between"><span class="text-slate-600">Đảo câu hỏi:</span><label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" id="setting-shuffle-q" class="sr-only peer" onchange="toggleShuffleQuestions(this)"><div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#D6336C]"></div></label></div>
                            <div class="flex items-center justify-between"><span class="text-slate-600">Đảo đáp án:</span><label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" id="setting-shuffle-a" class="sr-only peer" onchange="toggleShuffleAnswers(this)"><div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#D6336C]"></div></label></div>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 space-y-4">
                        <h4 class="font-bold text-slate-800 text-sm uppercase tracking-wider border-b pb-2"><i class="fa-solid fa-list-ol mr-2 text-slate-600"></i> Mục lục</h4>
                        <div id="question-palette" class="grid grid-cols-5 gap-2 max-h-64 overflow-y-auto p-1"></div>
                    </div>
                </div>

                <div class="lg:col-span-3 space-y-6">
                    <div id="question-container" class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 space-y-6"></div>
                    <div class="flex justify-between items-center bg-white p-4 rounded-2xl shadow-sm border border-slate-100">
                        <button onclick="prevQuestion()" id="btn-prev" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2.5 rounded-xl font-medium text-sm transition flex items-center"><i class="fa-solid fa-arrow-left mr-2"></i> Câu trước</button>
                        <button onclick="markUnsure()" class="bg-[#FFF5F8] hover:bg-[#FFB6C1]/30 text-[#D6336C] border border-[#FFB6C1] px-5 py-2.5 rounded-xl font-medium text-sm transition">Phân vân</button>
                        <button onclick="nextQuestion()" id="btn-next" class="bg-[#D6336C] hover:bg-[#FF4081] text-white px-5 py-2.5 rounded-xl font-medium text-sm transition flex items-center">Câu sau <i class="fa-solid fa-arrow-right ml-2"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: ÔN TẬP CÂU SAI -->
        <div id="tab-mistakes" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex justify-between items-center">
                <div><h2 class="text-2xl font-bold text-slate-900">Sổ Tay Ôn Tập Câu Sai</h2><p class="text-sm text-slate-500">Tổng hợp các câu trả lời sai của riêng bạn.</p></div>
                <button onclick="startMistakeReview()" id="btn-review-mistakes" class="bg-[#D6336C] hover:bg-[#FF4081] text-white px-5 py-2.5 rounded-xl font-medium text-sm transition shadow-sm flex items-center"><i class="fa-solid fa-rotate-right mr-2"></i> Luyện tập lại câu sai</button>
            </div>
            <div id="mistakes-container" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </div>

        <!-- TAB 4: HABIT TRACKER -->
        <div id="tab-habit" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                    <div><h2 class="text-2xl font-bold text-slate-900">Habit Tracker - Tiến Độ Học Tập</h2><p class="text-sm text-slate-500">Duy trì thói quen luyện đề mỗi ngày.</p></div>
                    <div class="flex items-center gap-4 bg-[#FFF5F8] px-4 py-3 rounded-2xl border border-[#FFB6C1]">
                        <div class="text-[#D6336C] text-2xl font-bold"><i class="fa-solid fa-fire text-[#FF4081] mr-2"></i><span id="streak-count">0</span> ngày</div>
                        <div class="text-xs text-[#D6336C] font-medium">Chuỗi Streak liên tiếp</div>
                    </div>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-4" id="habit-grid"></div>
            </div>
        </div>
    </main>

    <!-- MODAL: ĐĂNG NHẬP / ĐĂNG KÝ -->
    <div id="modal-auth" class="fixed inset-0 bg-slate-900/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-8 shadow-2xl space-y-6">
            <div class="text-center space-y-2">
                <div class="bg-[#FFF5F8] text-[#D6336C] w-12 h-12 rounded-2xl flex items-center justify-center mx-auto text-xl font-bold"><i class="fa-solid fa-stethoscope"></i></div>
                <h3 class="text-2xl font-bold text-slate-900">VMU TestExam Pro</h3>
                <p class="text-sm text-slate-500">Đăng nhập tài khoản cá nhân</p>
            </div>

            <div class="space-y-4 text-sm">
                <div>
                    <label class="block font-medium text-slate-700 mb-1">Tên đăng nhập</label>
                    <input type="text" id="auth-username" placeholder="Nhập username..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]">
                </div>
                <div>
                    <label class="block font-medium text-slate-700 mb-1">Mật khẩu</label>
                    <input type="password" id="auth-password" placeholder="Nhập mật khẩu..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]">
                </div>
                <div id="auth-error-msg" class="text-rose-600 text-xs text-center font-medium hidden"></div>
            </div>

            <div class="space-y-3">
                <button onclick="handleLogin()" class="w-full bg-[#D6336C] hover:bg-[#FF4081] text-white py-3 rounded-xl font-bold text-sm transition shadow-sm">Đăng Nhập</button>
                <button onclick="handleRegister()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 py-3 rounded-xl font-bold text-sm transition">Đăng Ký Tài Khoản Mới</button>
            </div>
        </div>
    </div>

    <!-- MODAL: QUẢN LÝ USERS -->
    <div id="modal-users" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl space-y-4 max-h-[85vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-lg font-bold text-slate-900"><i class="fa-solid fa-users-gear text-[#D6336C] mr-2"></i> Phê Duyệt Thành Viên</h3>
                <button onclick="closeUsersModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div id="users-list-container" class="space-y-3"></div>
            <div class="flex justify-end pt-2 border-t">
                <button onclick="closeUsersModal()" class="px-5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium">Đóng</button>
            </div>
        </div>
    </div>

    <!-- MODAL: THÊM MÔN HỌC -->
    <div id="modal-subject" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
            <h3 class="text-lg font-bold text-slate-900">Thêm Môn Học Mới</h3>
            <input type="text" id="input-new-subject" placeholder="Nhập tên môn học..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C] text-sm">
            <div class="flex justify-end space-x-3 pt-2">
                <button onclick="closeSubjectModal()" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-sm font-medium">Hủy</button>
                <button onclick="saveNewSubject()" class="bg-[#D6336C] hover:bg-[#FF4081] text-white px-5 py-2 rounded-xl text-sm font-medium">Lưu môn học</button>
            </div>
        </div>
    </div>

    <!-- MODAL: TẠO ĐỀ / TẢI NHIỀU FOLDER HOẶC FILE WORD -->
    <div id="modal-exam" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-lg font-bold text-slate-900"><i class="fa-solid fa-folder-tree text-[#D6336C] mr-2"></i> Tải Lên Folder / File Word Hàng Loạt</h3>
                <button onclick="closeCreateExamModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="space-y-4 text-sm">
                <div>
                    <label class="block font-medium text-slate-700 mb-1">Chọn Môn Học Đích</label>
                    <select id="modal-select-subject" onchange="updateChapterDropdown()" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]"></select>
                </div>
                
                <!-- PHẦN 1: TẢI NHIỀU FOLDER -->
                <div class="p-5 bg-[#FFF5F8] border-2 border-dashed border-[#FFB6C1] rounded-2xl space-y-3">
                    <label class="block font-bold text-slate-800"><i class="fa-solid fa-folder-open text-[#FF4081] mr-2"></i> Cách 1: Tải lên các Folder chứa bài học (.docx)</label>
                    <p class="text-xs text-slate-500">💡 Tên từng folder sẽ tự động làm tên Chương.</p>
                    <input type="file" id="modal-input-folder" accept=".docx" multiple webkitdirectory directory class="w-full text-sm text-slate-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-[#D6336C] file:text-white hover:file:bg-[#FF4081] cursor-pointer">
                </div>

                <!-- PHẦN 2: TẢI FILE ĐƠN LẺ -->
                <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-3">
                    <label class="block font-bold text-slate-800"><i class="fa-solid fa-file-word text-blue-600 mr-2"></i> Cách 2: Chọn các file Word (.docx) đơn lẻ</label>
                    
                    <div>
                        <label class="block font-medium text-slate-700 mb-1 text-xs">Chọn chương đích:</label>
                        <select id="modal-select-chapter" onchange="handleChapterSelectChange()" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C] text-sm">
                        </select>
                    </div>

                    <div id="new-chapter-input-container" class="hidden">
                        <label class="block font-medium text-slate-700 mb-1 text-xs">Nhập tên chương mới:</label>
                        <input type="text" id="modal-input-new-chapter" placeholder="Ví dụ: Chương 2: Tuần hoàn..." class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C] text-sm">
                    </div>

                    <div>
                        <label class="block font-medium text-slate-700 mb-1 text-xs">Chọn file Word (.docx):</label>
                        <input type="file" id="modal-input-docs" accept=".docx" multiple class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
                    </div>
                </div>
            </div>
            <div class="flex justify-end space-x-3 pt-2 border-t">
                <button onclick="closeCreateExamModal()" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-sm font-medium">Hủy</button>
                <button onclick="saveNewExam()" class="bg-[#D6336C] hover:bg-[#FF4081] text-white px-5 py-2 rounded-xl text-sm font-medium">Bắt Đầu Xử Lý & Nhập Đề</button>
            </div>
        </div>
    </div>

    <!-- MODAL CHỈNH SỬA TÊN CHƯƠNG / TÊN BÀI -->
    <div id="modal-rename" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl space-y-4">
            <h3 id="rename-modal-title" class="text-lg font-bold text-slate-900">Đổi tên</h3>
            <input type="text" id="input-rename-val" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C] text-sm">
            <div class="flex justify-end space-x-3 pt-2">
                <button onclick="closeRenameModal()" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-sm font-medium">Hủy</button>
                <button onclick="confirmRename()" class="bg-[#D6336C] hover:bg-[#FF4081] text-white px-5 py-2 rounded-xl text-sm font-medium">Lưu</button>
            </div>
        </div>
    </div>

    <!-- MODAL CHỈNH SỬA CÂU HỎI -->
    <div id="modal-edit-question" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-lg font-bold text-slate-900"><i class="fa-solid fa-pen-to-square text-[#D6336C] mr-2"></i> Sửa Câu Hỏi Hiện Tại</h3>
                <button onclick="closeEditQuestionModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="space-y-3 text-sm">
                <div>
                    <label class="block font-medium text-slate-700 mb-1">Nội dung câu hỏi</label>
                    <textarea id="edit-q-text" rows="3" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]"></textarea>
                </div>
                <div><label class="block font-medium text-slate-700 mb-1">Đáp án A</label><input type="text" id="edit-opt-0" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]"></div>
                <div><label class="block font-medium text-slate-700 mb-1">Đáp án B</label><input type="text" id="edit-opt-1" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]"></div>
                <div><label class="block font-medium text-slate-700 mb-1">Đáp án C</label><input type="text" id="edit-opt-2" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]"></div>
                <div><label class="block font-medium text-slate-700 mb-1">Đáp án D</label><input type="text" id="edit-opt-3" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]"></div>
                <div>
                    <label class="block font-medium text-slate-700 mb-1">Đáp án đúng</label>
                    <select id="edit-correct-ans" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]">
                        <option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option>
                    </select>
                </div>
                <div><label class="block font-medium text-slate-700 mb-1">Giải thích chi tiết</label><textarea id="edit-explanation" rows="2" class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-[#D6336C]"></textarea></div>
            </div>
            <div class="flex justify-end space-x-3 pt-2 border-t">
                <button onclick="closeEditQuestionModal()" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-sm font-medium">Hủy</button>
                <button onclick="saveEditedQuestion()" class="bg-[#D6336C] hover:bg-[#FF4081] text-white px-5 py-2 rounded-xl text-sm font-medium">Lưu thay đổi</button>
            </div>
        </div>
    </div>

    <!-- Script xử lý logic ứng dụng -->
    <script>
        let appData = { subjects: [] };
        let userPersonalData = { mistakes: [], habits: {} };
        let currentUser = null;
        let currentExam = null;
        let currentExamRef = { sIdx: null, cIdx: null, eIdx: null };
        let currentQuestionIndex = 0;
        let userAnswers = {};
        let unsureQuestions = {};
        let settings = { showAnswer: true, autoNext: false, shuffleQ: false, shuffleA: false };
        let activeQuestions = [];
        let collapsedSubjects = {};
        let collapsedChapters = {};
        let renameTarget = null;
        let syncTimeout = null;
        let appDataUnsub = null;
        let usersUnsub = null;

        const ADMIN_PASSWORD = "212696";

        window.initAppSession = async function() {
            let session = localStorage.getItem("vmu_current_user");
            if (session) {
                try { currentUser = JSON.parse(session); } catch(e) {}
            }

            if (!currentUser) {
                document.getElementById('modal-auth').classList.remove('hidden');
            } else {
                document.getElementById('modal-auth').classList.add('hidden');
                updateNavbarUser();
                startAppDataRealtimeSync();
                await loadUserPersonalData();
            }
        };

        function updateNavbarUser() {
            document.getElementById('nav-username').innerText = currentUser.username;
            const icon = document.getElementById('user-role-icon');
            const usersBtn = document.getElementById('nav-users-btn');
            const adminBtns = document.getElementById('admin-action-buttons');
            const adminDataMenu = document.getElementById('admin-data-menu');

            if (currentUser.role === 'admin') {
                icon.className = "fa-solid fa-user-shield text-[#FFB6C1]";
                usersBtn.classList.remove('hidden');
                adminBtns.classList.remove('hidden');
                adminDataMenu.classList.remove('hidden');
            } else {
                icon.className = "fa-solid fa-user text-emerald-300";
                usersBtn.classList.add('hidden');
                adminBtns.classList.add('hidden');
                adminDataMenu.classList.add('hidden');
            }
        }

        async function handleLogin() {
            let user = document.getElementById('auth-username').value.trim();
            let pass = document.getElementById('auth-password').value;
            let errEl = document.getElementById('auth-error-msg');
            errEl.classList.add('hidden');

            if (!user || !pass) {
                errEl.innerText = "Vui lòng nhập đầy đủ tên và mật khẩu!";
                errEl.classList.remove('hidden');
                return;
            }

            if (user.toLowerCase() === 'admin' || pass === ADMIN_PASSWORD) {
                if (pass === ADMIN_PASSWORD) {
                    currentUser = { username: user, role: 'admin', status: 'approved' };
                    localStorage.setItem("vmu_current_user", JSON.stringify(currentUser));
                    document.getElementById('modal-auth').classList.add('hidden');
                    updateNavbarUser();
                    startAppDataRealtimeSync();
                    await loadUserPersonalData();
                    return;
                }
            }

            try {
                if (window.firebaseDB) {
                    let docRef = window.firebaseDoc(window.firebaseDB, "users_list", user);
                    let snap = await window.firebaseGetDoc(docRef);
                    if (snap.exists()) {
                        let data = snap.data();
                        if (data.password === pass) {
                            if (data.status !== 'approved') {
                                errEl.innerText = "Tài khoản của bạn đang chờ Admin phê duyệt!";
                                errEl.classList.remove('hidden');
                                return;
                            }
                            currentUser = { username: user, role: 'member', status: 'approved' };
                            localStorage.setItem("vmu_current_user", JSON.stringify(currentUser));
                            document.getElementById('modal-auth').classList.add('hidden');
                            updateNavbarUser();
                            startAppDataRealtimeSync();
                            await loadUserPersonalData();
                            return;
                        }
                    }
                }
            } catch(e) {}

            errEl.innerText = "Sai tên đăng nhập, mật khẩu hoặc chưa được duyệt!";
            errEl.classList.remove('hidden');
        }

        async function handleRegister() {
            let user = document.getElementById('auth-username').value.trim();
            let pass = document.getElementById('auth-password').value;
            let errEl = document.getElementById('auth-error-msg');
            errEl.classList.add('hidden');

            if (!user || !pass) {
                errEl.innerText = "Vui lòng nhập đầy đủ tên và mật khẩu!";
                errEl.classList.remove('hidden');
                return;
            }

            if (user.toLowerCase() === 'admin') {
                errEl.innerText = "Tên tài khoản không hợp lệ!";
                errEl.classList.remove('hidden');
                return;
            }

            try {
                if (window.firebaseDB) {
                    let docRef = window.firebaseDoc(window.firebaseDB, "users_list", user);
                    let snap = await window.firebaseGetDoc(docRef);
                    if (snap.exists()) {
                        errEl.innerText = "Tên đăng nhập đã tồn tại!";
                        errEl.classList.remove('hidden');
                        return;
                    }
                    await window.firebaseSetDoc(docRef, { username: user, password: pass, status: 'pending', role: 'member' });
                    alert('Đăng ký thành công! Vui lòng chờ Admin phê duyệt.');
                }
            } catch(e) {
                alert('Lỗi kết nối Cloud!');
            }
        }

        function logoutAccount() {
            if (appDataUnsub) appDataUnsub();
            localStorage.removeItem("vmu_current_user");
            currentUser = null;
            document.getElementById('auth-username').value = '';
            document.getElementById('auth-password').value = '';
            document.getElementById('modal-auth').classList.remove('hidden');
        }

        function openUsersModal() {
            if (!currentUser || currentUser.role !== 'admin') return;
            const container = document.getElementById('users-list-container');
            container.innerHTML = `<p class="text-sm text-slate-400 text-center py-4">Đang kết nối Realtime...</p>`;
            document.getElementById('modal-users').classList.remove('hidden');

            if (usersUnsub) usersUnsub();

            try {
                if (window.firebaseDB) {
                    let colRef = window.firebaseCollection(window.firebaseDB, "users_list");
                    // LẮNG NGHE REALTIME DANH SÁCH USER
                    usersUnsub = window.firebaseOnSnapshot(colRef, (querySnap) => {
                        let html = '';
                        querySnap.forEach((docSnap) => {
                            let u = docSnap.data();
                            let isPending = u.status === 'pending';
                            html += `
                                <div class="bg-slate-50 p-4 rounded-xl border flex justify-between items-center" id="user-row-${u.username}">
                                    <div>
                                        <h4 class="font-bold text-slate-800">${u.username}</h4>
                                        <span class="text-xs px-2 py-0.5 rounded-full font-semibold ${isPending ? 'bg-[#FFF5F8] text-[#D6336C]' : 'bg-emerald-100 text-emerald-800'}" id="user-status-${u.username}">${isPending ? 'Chờ duyệt' : 'Đã duyệt'}</span>
                                    </div>
                                    <div class="space-x-2">
                                        ${isPending ? `<button onclick="approveUser('${u.username}')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition">Phê duyệt</button>` : ''}
                                        <button onclick="deleteUser('${u.username}')" class="bg-rose-100 hover:bg-rose-200 text-rose-700 px-3 py-1.5 rounded-lg text-xs font-bold transition">Xóa</button>
                                    </div>
                                </div>
                            `;
                        });
                        container.innerHTML = html || `<p class="text-sm text-slate-400 text-center py-4">Chưa có thành viên nào.</p>`;
                    });
                }
            } catch(e) {
                container.innerHTML = `<p class="text-sm text-rose-500 text-center py-4">Lỗi kết nối Realtime.</p>`;
            }
        }

        function closeUsersModal() { 
            if (usersUnsub) { usersUnsub(); usersUnsub = null; }
            document.getElementById('modal-users').classList.add('hidden'); 
        }

        async function approveUser(username) {
            try {
                if (window.firebaseDB) {
                    let docRef = window.firebaseDoc(window.firebaseDB, "users_list", username);
                    await window.firebaseSetDoc(docRef, { status: 'approved' }, { merge: true });
                }
            } catch(e) {}
        }

        async function deleteUser(username) {
            if (confirm(`Xóa user ${username}?`)) {
                try {
                    if (window.firebaseDB) {
                        let docRef = window.firebaseDoc(window.firebaseDB, "users_list", username);
                        await window.firebaseDeleteDoc(docRef);
                    }
                } catch(e) {}
            }
        }

        // ĐỒNG BỘ REALTIME TỨC THÌ TRONG DƯỚI 1 GIÂY BẰNG ONSNAPSHOT
        function startAppDataRealtimeSync() {
            let localData = localStorage.getItem("vmu_local_exam_backup");
            if (localData) {
                try { 
                    appData = JSON.parse(localData); 
                    renderHome(); 
                } catch(err) {}
            }

            if (appDataUnsub) appDataUnsub();

            try {
                if (window.firebaseDB) {
                    const docRef = window.firebaseDoc(window.firebaseDB, "users", "my_data");
                    
                    appDataUnsub = window.firebaseOnSnapshot(docRef, (docSnap) => {
                        if (docSnap.exists()) {
                            let cloudData = docSnap.data();
                            let cloudStr = JSON.stringify(cloudData);
                            let currentLocalStr = localStorage.getItem("vmu_local_exam_backup");

                            if (cloudStr !== currentLocalStr) {
                                appData = cloudData;
                                localStorage.setItem("vmu_local_exam_backup", cloudStr);
                                renderHome();
                            }
                        } else if (!appData.subjects || appData.subjects.length === 0) {
                            initDefaultData();
                        }
                    }, (err) => {
                        console.error("Lỗi đồng bộ Realtime:", err);
                    });
                }
            } catch (e) {
                if (!appData.subjects || appData.subjects.length === 0) initDefaultData();
            }
        }

        function initDefaultData() {
            appData = {
                subjects: [{
                    name: "Giải phẫu học",
                    chapters: [{
                        chapterName: "Chương 1: Chi trên",
                        exams: [{
                            id: "ex_1",
                            title: "Bài 1: Xương khớp chi trên",
                            questions: [{
                                id: 1,
                                questionText: "Xương nào sau đây thuộc cẳng tay?",
                                options: ["A. Xương cánh tay", "B. Xương quay", "C. Xương đùi", "D. Xương chày"],
                                correctAnswer: 1,
                                explanation: "Cẳng tay gồm hai xương là xương quay và xương trụ."
                            }]
                        }]
                    }]
                }]
            };
            renderHome();
        }

        function saveAppDataToCloud() {
            if (!currentUser || currentUser.role !== 'admin') return;
            let jsonStr = JSON.stringify(appData);
            localStorage.setItem("vmu_local_exam_backup", jsonStr);

            if (syncTimeout) clearTimeout(syncTimeout);
            syncTimeout = setTimeout(async () => {
                try {
                    if (window.firebaseDB) {
                        const docRef = window.firebaseDoc(window.firebaseDB, "users", "my_data");
                        await window.firebaseSetDoc(docRef, appData);
                    }
                } catch (e) {
                    console.error("Lỗi đẩy dữ liệu Cloud:", e);
                }
            }, 200);
        }

        async function loadUserPersonalData() {
            let userKey = currentUser.username;
            try {
                if (window.firebaseDB) {
                    const docRef = window.firebaseDoc(window.firebaseDB, "users_data", userKey);
                    const docSnap = await window.firebaseGetDoc(docRef);
                    if (docSnap.exists()) {
                        userPersonalData = docSnap.data();
                    } else {
                        userPersonalData = { mistakes: [], habits: {} };
                    }
                }
            } catch(e) {
                let local = localStorage.getItem("vmu_personal_" + userKey);
                if (local) userPersonalData = JSON.parse(local);
            }
            updateMistakeBadge();
            renderHabitTracker();
        }

        function saveUserPersonalData() {
            let userKey = currentUser.username;
            localStorage.setItem("vmu_personal_" + userKey, JSON.stringify(userPersonalData));
            try {
                if (window.firebaseDB) {
                    const docRef = window.firebaseDoc(window.firebaseDB, "users_data", userKey);
                    window.firebaseSetDoc(docRef, userPersonalData);
                }
            } catch(e) {}
            updateMistakeBadge();
        }

        function switchTab(tabId) {
            document.getElementById('tab-home').classList.add('hidden');
            document.getElementById('tab-exam').classList.add('hidden');
            document.getElementById('tab-mistakes').classList.add('hidden');
            document.getElementById('tab-habit').classList.add('hidden');

            document.getElementById('nav-home').classList.remove('bg-[#FF4081]');
            document.getElementById('nav-mistakes').classList.remove('bg-[#FF4081]');
            document.getElementById('nav-habit').classList.remove('bg-[#FF4081]');

            if (tabId === 'home') {
                document.getElementById('tab-home').classList.remove('hidden');
                document.getElementById('nav-home').classList.add('bg-[#FF4081]');
                renderHome();
            } else if (tabId === 'exam') {
                document.getElementById('tab-exam').classList.remove('hidden');
            } else if (tabId === 'mistakes') {
                document.getElementById('tab-mistakes').classList.remove('hidden');
                document.getElementById('nav-mistakes').classList.add('bg-[#FF4081]');
                renderMistakes();
            } else if (tabId === 'habit') {
                document.getElementById('tab-habit').classList.remove('hidden');
                document.getElementById('nav-habit').classList.add('bg-[#FF4081]');
                renderHabitTracker();
            }
        }

        function extractNumber(name) {
            let match = name.match(/\d+/);
            return match ? parseInt(match[0]) : 9999;
        }

        function renderHome() {
            const container = document.getElementById('subjects-container');
            if (!appData.subjects || appData.subjects.length === 0) {
                container.innerHTML = `<div class="bg-white p-8 rounded-2xl text-center text-slate-400">Chưa có môn học nào.</div>`;
                return;
            }

            let isAdmin = currentUser && currentUser.role === 'admin';
            let html = '';
            appData.subjects.forEach((subj, sIdx) => {
                if (subj.chapters && subj.chapters.length > 0) {
                    subj.chapters.sort((a, b) => extractNumber(a.chapterName) - extractNumber(b.chapterName));
                }

                let isSubjCollapsed = collapsedSubjects[sIdx] !== undefined ? collapsedSubjects[sIdx] : true;
                html += `
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                        <div class="bg-[#FFF5F8] px-6 py-4 flex justify-between items-center border-b border-[#FFB6C1]/30">
                            <div class="flex items-center space-x-3 cursor-pointer select-none" onclick="toggleSubjectCollapse(${sIdx})">
                                <i class="fa-solid fa-chevron-${isSubjCollapsed ? 'right' : 'down'} text-slate-400 text-xs"></i>
                                <h3 class="font-bold text-slate-900 text-lg flex items-center"><i class="fa-solid fa-book-medical text-[#D6336C] mr-2"></i> ${subj.name}</h3>
                            </div>
                            <div class="flex items-center space-x-2">
                                ${isAdmin ? `<button onclick="deleteSubject(${sIdx})" class="text-slate-400 hover:text-[#D6336C] p-1 text-sm transition" title="Xóa môn"><i class="fa-solid fa-trash"></i></button>` : ''}
                            </div>
                        </div>
                        <div class="p-6 space-y-4 ${isSubjCollapsed ? 'hidden' : ''}">
                `;

                if (!subj.chapters || subj.chapters.length === 0) {
                    html += `<p class="text-sm text-slate-400 italic">Chưa có chương học nào.</p>`;
                } else {
                    subj.chapters.forEach((chap, cIdx) => {
                        if (chap.exams && chap.exams.length > 0) {
                            chap.exams.sort((a, b) => extractNumber(a.title) - extractNumber(b.title));
                        }

                        let chapKey = `${sIdx}_${cIdx}`;
                        let isChapCollapsed = collapsedChapters[chapKey] !== undefined ? collapsedChapters[chapKey] : true;
                        html += `
                            <div class="space-y-2 bg-[#FFF5F8]/60 p-4 rounded-xl border border-[#FFB6C1]/30">
                                <div class="flex justify-between items-center">
                                    <div class="flex items-center space-x-2 cursor-pointer select-none" onclick="toggleChapterCollapse(${sIdx}, ${cIdx})">
                                        <i class="fa-solid fa-chevron-${isChapCollapsed ? 'right' : 'down'} text-slate-400 text-xs"></i>
                                        <h4 class="font-semibold text-slate-700 text-sm"><i class="fa-solid fa-bookmark text-[#FF4081] mr-2 text-xs"></i> ${chap.chapterName}</h4>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        ${isAdmin ? `
                                            <button onclick="openRenameModal('chapter', ${sIdx}, ${cIdx}, null)" class="text-slate-400 hover:text-blue-600 p-1 text-xs" title="Sửa tên chương"><i class="fa-solid fa-pen"></i></button>
                                            <button onclick="deleteChapter(${sIdx}, ${cIdx})" class="text-slate-400 hover:text-[#D6336C] p-1 text-xs" title="Xóa chương"><i class="fa-solid fa-trash"></i></button>
                                        ` : ''}
                                    </div>
                                </div>
                                <!-- GRID CÁC Ô ĐỀ THI NGẮN GỌN HƠN ĐỂ TIẾT KIỆM DIỆN TÍCH -->
                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 pl-2 pt-2 ${isChapCollapsed ? 'hidden' : ''}">
                        `;

                        if (!chap.exams || chap.exams.length === 0) {
                            html += `<span class="text-xs text-slate-400 italic">Chưa có bài học.</span>`;
                        } else {
                            chap.exams.forEach((ex, eIdx) => {
                                html += `
                                    <div class="bg-white p-3 rounded-xl border border-slate-200 hover:border-[#FFB6C1] transition shadow-xs flex flex-col justify-between space-y-2 min-h-[100px]">
                                        <div>
                                            <h5 class="font-bold text-slate-800 text-xs line-clamp-2" title="${ex.title}">${ex.title}</h5>
                                            <span class="text-[11px] text-slate-400 mt-1 block"><i class="fa-solid fa-circle-question mr-1"></i> ${ex.questions.length} câu</span>
                                        </div>
                                        <div class="flex justify-between items-center pt-1 border-t border-slate-100">
                                            <button onclick="startExam('${sIdx}', '${cIdx}', '${eIdx}')" class="bg-[#FFF5F8] hover:bg-[#D6336C] hover:text-white text-[#D6336C] px-2.5 py-1 rounded-lg text-[11px] font-semibold transition">Vào thi</button>
                                            ${isAdmin ? `
                                            <div class="flex items-center space-x-1">
                                                <button onclick="openRenameModal('exam', ${sIdx}, ${cIdx}, ${eIdx})" class="text-slate-400 hover:text-blue-600 p-0.5 text-[11px]" title="Sửa tên bài"><i class="fa-solid fa-pen"></i></button>
                                                <button onclick="deleteExam('${sIdx}', ${cIdx}, ${eIdx})" class="text-slate-400 hover:text-[#D6336C] text-[11px] p-0.5" title="Xóa bài"><i class="fa-solid fa-trash"></i></button>
                                            </div>` : ''}
                                        </div>
                                    </div>
                                `;
                            });
                        }
                        html += `</div></div>`;
                    });
                }
                html += `</div></div>`;
            });
            container.innerHTML = html;
        }

