        // HÀM TẢI FILE WORD / FOLDER DỰÁ TRÊN MAMMOTH.JS
        async function saveNewExam() {
            const sIdx = document.getElementById('modal-select-subject').value;
            const folderInput = document.getElementById('modal-input-folder');
            const fileInput = document.getElementById('modal-input-docs');

            if (sIdx === "" || sIdx === null) return alert('Vui lòng chọn môn học!');
            let subj = appData.subjects[sIdx];
            if (!subj) return alert('Vui lòng chọn môn học hợp lệ!');

            let processedCount = 0;
            let filesToProcess = [];

            if (folderInput.files && folderInput.files.length > 0) {
                for (let f of folderInput.files) filesToProcess.push({ file: f, isFolder: true });
            }
            if (fileInput.files && fileInput.files.length > 0) {
                for (let f of fileInput.files) filesToProcess.push({ file: f, isFolder: false });
            }

            if (filesToProcess.length === 0) {
                return alert('Vui lòng chọn ít nhất 1 file .docx hoặc folder!');
            }

            for (let item of filesToProcess) {
                let file = item.file;
                let fileName = file.name;

                if (!fileName.toLowerCase().endsWith('.docx') || fileName.startsWith('~$')) continue;

                try {
                    let arrayBuffer = await file.arrayBuffer();
                    let result = await mammoth.extractRawText({ arrayBuffer: arrayBuffer });
                    let questions = parseBulkQuestions(result.value);

                    if (questions && questions.length > 0) {
                        let targetChapter = null;
                        let examTitle = fileName.replace(/\.[^/.]+$/, "");

                        if (item.isFolder) {
                            let pathParts = file.webkitRelativePath ? file.webkitRelativePath.split('/') : [fileName];
                            let chapterName = "Chương 1";
                            if (pathParts.length > 1) {
                                chapterName = pathParts[pathParts.length - 2].replace(/[_]/g, ' ').trim();
                            }
                            targetChapter = subj.chapters.find(c => c.chapterName.toLowerCase() === chapterName.toLowerCase());
                            if (!targetChapter) {
                                targetChapter = { chapterName: chapterName, exams: [] };
                                subj.chapters.push(targetChapter);
                            }
                        } else {
                            let chapSelectVal = document.getElementById('modal-select-chapter').value;
                            if (chapSelectVal === "NEW") {
                                let newChapName = document.getElementById('modal-input-new-chapter').value.trim() || "Chương mới";
                                targetChapter = subj.chapters.find(c => c.chapterName.toLowerCase() === newChapName.toLowerCase());
                                if (!targetChapter) {
                                    targetChapter = { chapterName: newChapName, exams: [] };
                                    subj.chapters.push(targetChapter);
                                }
                            } else {
                                let idx = parseInt(chapSelectVal);
                                if (!isNaN(idx) && subj.chapters[idx]) {
                                    targetChapter = subj.chapters[idx];
                                } else {
                                    targetChapter = { chapterName: "Chương 1", exams: [] };
                                    subj.chapters.push(targetChapter);
                                }
                            }
                        }

                        let existingExam = targetChapter.exams.find(e => e.title === examTitle);
                        if (existingExam) {
                            existingExam.questions = questions;
                        } else {
                            targetChapter.exams.push({
                                id: 'ex_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
                                title: examTitle,
                                questions: questions
                            });
                        }
                        processedCount++;
                    }
                } catch (err) {
                    console.error("Lỗi đọc file:", fileName, err);
                }
            }

            if (processedCount === 0) {
                return alert('Không bóc tách được câu hỏi nào! Vui lòng đảm bảo bạn chọn đúng file .docx.');
            }

            saveAppDataToCloud();
            closeCreateExamModal();
            renderHome();
            alert(`Thành công! Đã nhập ${processedCount} bài học mới.`);
        }

        // BỘ TÁCH CÂU HỎI THUẬT TOÁN TỐI ƯU
        function parseBulkQuestions(text) {
            if (!text) return [];

            let rawText = text.replace(/\r\n/g, ' ').replace(/\n/g, ' ').replace(/\r/g, ' ');
            let blocks = rawText.split(/(?=(?:Q\s*[:\.]|Q\s*\d+[\.:]|Câu\s*\d+[\.:]|Question\s*\d+[\.:]))/i);
            let questions = [];

            blocks.forEach(block => {
                block = block.trim();
                if (!block) return;

                let match = block.match(/^(?:Q\s*[:\.]?|Câu\s*\d+[\.:]?|Question\s*\d+[\.:]?|\d+[\.:])?\s*(.*?)(?=\s*A[\.\)\:]\s*)(.*?)(?=\s*B[\.\)\:]\s*)(.*?)(?=\s*C[\.\)\:]\s*)(.*?)(?=\s*D[\.\)\:]\s*)(.*?)(?=\s*(?:A\s*[:\.]|Ans\s*[:\.]|Answer\s*[:\.]|Đáp\s*án\s*[:\.]|Key\s*[:\.]|ĐA\s*[:\.]|\*?[A-D][\.\)\:]|$))(?:(?:A\s*[:\.]|Ans\s*[:\.]|Answer\s*[:\.]|Đáp\s*án\s*[:\.]|Key\s*[:\.]|ĐA\s*[:\.]|\*?[A-D][\.\)\:])\s*([A-D])[\.\)\:]?\s*)?(?:(?:E\s*[:\.]|Exp\s*[:\.]|Explanation\s*[:\.]|Giải\s*thích\s*[:\.]|\*)\s*(.*))?$/i);

                if (match) {
                    let qText = match[1].replace(/^(?:Q\s*[:\.]?|Câu\s*\d+[\.:]?|Question\s*\d+[\.:]?|\d+[\.:])\s*/i, '').trim();
                    let optA = "A. " + match[2].replace(/^A[\.\)\:]\s*/i, '').trim();
                    let optB = "B. " + match[3].replace(/^B[\.\)\:]\s*/i, '').trim();
                    let optC = "C. " + match[4].replace(/^C[\.\)\:]\s*/i, '').trim();
                    let optDText = match[5].trim();
                    
                    optDText = optDText.replace(/\s*(?:A\s*[:\.]|Ans\s*[:\.]|Answer\s*[:\.]|Đáp\s*án\s*[:\.]|Key\s*[:\.]|E\s*[:\.]|Giải\s*thích\s*[:\.]).*/i, '').trim();
                    let optD = "D. " + optDText.replace(/^D[\.\)\:]\s*/i, '').trim();

                    let ansChar = match[6] ? match[6].toUpperCase() : 'A';
                    let correctIdx = ansChar.charCodeAt(0) - 65;
                    if (correctIdx < 0 || correctIdx > 3) correctIdx = 0;

                    let expText = match[7] ? match[7].trim() : "";

                    if (qText && match[2] && match[3]) {
                        questions.push({
                            id: questions.length + 1,
                            questionText: qText,
                            options: [optA, optB, optC, optD],
                            correctAnswer: correctIdx,
                            explanation: expText
                        });
                    }
                }
            });

            if (questions.length === 0) {
                let fallbackMatches = rawText.matchAll(/(?:Q\s*[:\.]?|Câu\s*\d+[\.:]?)\s*(.*?)\s*A[\.\)\:]\s*(.*?)\s*B[\.\)\:]\s*(.*?)\s*C[\.\)\:]\s*(.*?)\s*D[\.\)\:]\s*(.*?)\s*A\s*[:\.]\s*([A-D])\s*(?:E\s*[:\.]\s*(.*?))?(?=(?:Q\s*[:\.]|Câu\s*\d+[\.:]|$))/gi);
                for (let m of fallbackMatches) {
                    let ansChar = m[6].toUpperCase();
                    questions.push({
                        id: questions.length + 1,
                        questionText: m[1].trim(),
                        options: ["A. " + m[2].trim(), "B. " + m[3].trim(), "C. " + m[4].trim(), "D. " + m[5].trim()],
                        correctAnswer: ansChar.charCodeAt(0) - 65,
                        explanation: m[7] ? m[7].trim() : ""
                    });
                }
            }

            return questions;
        }

